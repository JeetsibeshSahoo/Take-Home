# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For local dev outside Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swarn_sathi?schema=public"

# For Docker Compose internal networking:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/swarn_sathi?schema=public"

# Security Secrets
JWT_SECRET="swarn_sathi_secure_jwt_secret_dev_key_2026"
MAGIC_CODE_EXPIRY_MINUTES=10
MAX_MAGIC_CODE_ATTEMPTS=5

# Rate Limiting Settings (Tier 1 requirement)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5

# Frontend Client URL (for CORS)
CLIENT_URL="http://localhost:5173"